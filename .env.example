POSTGRES_DB=geninvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Depuis un conteneur de l'application, utiliser db comme hote.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/geninvest

# Renseigner cette valeur uniquement dans le fichier .env local.
GOOGLE_API_KEY=COLLER_VOTRE_CLE_GOOGLE_ICI
PDF_COLLECTION=pdf_chunks
EMBEDDING_MODEL=gemini-embedding-001
