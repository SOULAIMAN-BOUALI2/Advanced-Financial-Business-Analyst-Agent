FROM python:3.12-slim

WORKDIR /app

# Copie le requirements.txt depuis la racine du contexte
COPY requirements.txt .

# Le backend assemble l'API, l'agent et le module analytics.
COPY backend/ ./backend/
COPY ai_agents/ ./ai_agents/
COPY data_engineering/ ./data_engineering/

RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir -r ai_agents/requirements.txt

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]